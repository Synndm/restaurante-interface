algoritmo "semnome"
// Disciplina   : [Linguagem e Lógica de Programação] 
// Professor   : Antonio Carlos Nicolodi 
var
   n : inteiro
inicio
      escreval("Digite um valor: ")
      leia(n)
      se(n>=1)e(n<=9)entao
           escreval("O valor está na faixa permitida!")
      senao
           escreval("O valor não está na faixa permitida!")
      fimse
fimalgoritmo